# Same headers the API sets through helmet. Keep the CSP equal to the one in
# backend/internal/adapter/http/server.go.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}
}

# A real domain in SITE_ADDRESS turns on automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle /assets/* {
		import security_headers
		root * /srv
		# Only real files are immutable; a missing hash must not be cached for a year.
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		import security_headers
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
