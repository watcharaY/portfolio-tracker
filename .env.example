POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable
ADDR=:8080
SESSION_TTL=168h
COOKIE_SECURE=false
# Comma-separated IPs/CIDRs (or "private", "loopback") allowed to set X-Forwarded-For. Empty = none.
TRUSTED_PROXIES=
RATE_LIMIT_PER_MINUTE=300
# json (default in the binary) or text
LOG_FORMAT=text
