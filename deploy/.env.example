# Copy to deploy/.env. The password goes into a URL, so use letters and digits only.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# :80 serves plain HTTP on any host name. A real domain (portfolio.example.com)
# makes Caddy fetch a certificate and serve HTTPS; then set COOKIE_SECURE=true.
SITE_ADDRESS=:80
COOKIE_SECURE=false
SESSION_TTL=168h

# Host ports, if 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443
